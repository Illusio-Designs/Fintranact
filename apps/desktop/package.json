{
  "name": "@fintranact/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Fintranact Windows desktop app (Electron) — reuses shared UI + same APIs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && electron dist/main.js",
    "start": "electron dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "typescript": "^5.4.0"
  },
  "build": {
    "appId": "in.ravimetal.fintranact",
    "productName": "Fintranact",
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
